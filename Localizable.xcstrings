    "The DNS server couldn't be reached. Check your internet connection and try again." : {
      "comment" : "Domain Resolver: explanation below the result when the DNS lookup failed",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der DNS-Server war nicht erreichbar. Prüfe deine Internetverbindung und versuche es erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se ha podido contactar con el servidor DNS. Comprueba tu conexión a internet y vuelve a intentarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de joindre le serveur DNS. Vérifiez votre connexion Internet et réessayez."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De DNS-server is niet bereikbaar. Controleer je internetverbinding en probeer het opnieuw."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie udało się połączyć z serwerem DNS. Sprawdź połączenie z internetem i spróbuj ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível acessar o servidor DNS. Verifique sua conexão com a internet e tente novamente."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det gick inte att nå DNS-servern. Kontrollera din internetanslutning och försök igen."
          }
        }
      }
    },
    "The camera can't be used to scan barcodes on this device right now." : {
      "comment" : "Barcode Scanner: shown when the camera could not be started for a reason other than a denied permission",
      "localizations" : {
        "de" : {
          "stringUnit" : {
