    "Tap %@ to scan again. If nothing shows up, check that Toolbox can access your local network in Settings." : {
      "comment" : "LAN Scanner empty state, %@ is the reload symbol",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippe auf %@, um erneut zu suchen. Wenn nichts erscheint, prüfe in den Einstellungen, ob Toolbox auf dein lokales Netzwerk zugreifen darf."
          }
        }
      }
    },
    "Tap %@ to scan your first barcode." : {
      "comment" : "Barcode Scanner empty state, %@ is the scan symbol",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippe auf %@, um deinen ersten Barcode zu scannen."
          }
        }
      }
    },
    "Tap + to add a device you want to wake up." : {
      "comment" : "Wake On Lan empty state",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippe auf +, um ein Gerät hinzuzufügen, das du aufwecken möchtest."
          }
        }
      }
    },
    "Tilt your iPhone to see the light play on the glass." : {
      "comment" : "App icon picker hint",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neige dein iPhone, um das Licht auf dem Glas spielen zu sehen."
          }
        }
      }
    },
    "To find devices on your network and to wake them up." : {
      "comment" : "Permission reason",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um Geräte in deinem Netzwerk zu finden und aufzuwecken."
          }
        }
      }
    },
    "To measure the sound level around you." : {
      "comment" : "Permission reason",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um den Geräuschpegel um dich herum zu messen."
          }
        }
      }
    },
    "To scan barcodes and to show scrolling text on the back display." : {
      "comment" : "Permission reason",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um Barcodes zu scannen und Lauftext auf dem Rückdisplay anzuzeigen."
          }
        }
      }
    },
    "To show your coordinates and speed and to measure distances." : {
      "comment" : "Permission reason",
      "localizations" : {
