          }
        }
      }
    },
    "The camera couldn't be started, so the text can't be shown on the back display right now." : {
      "comment" : "Scrolling Text: alert message when the camera, which the back display needs, fails to start although access is allowed",
      "localizations" : {
        "de" : {
          "stringUnit" : {
