    "The back display is only available while the camera is active, so the camera turns on while the text is shown there." : {
      "comment" : "Scrolling Text: note below the back display button",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Rückseite ist nur verfügbar, während die Kamera aktiv ist. Deshalb schaltet sich die Kamera ein, solange der Text dort angezeigt wird."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La pantalla trasera solo está disponible mientras la cámara está activa, así que la cámara se enciende mientras el texto se muestra en ella."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’écran arrière n’est disponible que lorsque l’appareil photo est actif ; l’appareil photo s’allume donc pendant que le texte y est affiché."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het achterscherm is alleen beschikbaar als de camera actief is, dus de camera gaat aan zolang de tekst daar wordt getoond."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tylny ekran jest dostępny tylko przy aktywnym aparacie, dlatego aparat włącza się na czas wyświetlania tekstu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A tela traseira só fica disponível enquanto a câmera está ativa, por isso a câmera é ligada enquanto o texto é exibido nela."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den bakre skärmen är bara tillgänglig när kameran är aktiv, så kameran slås på medan texten visas där."
          }
        }
      }
    },
