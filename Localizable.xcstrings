    "The app will close after deleting the data. You can instantly reopen it." : {
      "comment" : "Info screen: message of the delete data alert",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die App wird auch dem Löschen der Daten geschlossen. Das kannst sie aber direkt wieder öffnen."
          }
