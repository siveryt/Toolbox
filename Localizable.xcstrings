    "Note: Font collections contain multiple fonts in one file, but iOS can only install individual fonts through configuration profiles." : {
      "comment" : "A footnote explaining that font collections are not supported by iOS.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hinweis: Eine Font-Sammlung enthält mehrere Fonts in einer Datei, iOS kann über Konfigurationsprofile aber nur einzelne Fonts installieren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nota: Las colecciones contienen varios tipos de letra en un solo archivo, pero iOS solo puede instalar tipos de letra individuales mediante perfiles de configuración."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Remarque : une collection contient plusieurs polices dans un seul fichier, mais iOS ne peut installer que des polices individuelles via des profils de configuration."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Let op: lettertypecollecties bevatten meerdere lettertypen in één bestand, maar iOS kan via configuratieprofielen alleen afzonderlijke lettertypen installeren."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uwaga: kolekcje czcionek zawierają wiele czcionek w jednym pliku, a iOS może instalować przez profile konfiguracji tylko pojedyncze czcionki."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Observação: as coleções de fontes contêm várias fontes em um só arquivo, mas o iOS só consegue instalar fontes individuais por meio de perfis de configuração."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obs! Typsnittssamlingar innehåller flera typsnitt i en fil, men iOS kan bara installera enskilda typsnitt via konfigurationsprofiler."
          }
        }
      }
    },
