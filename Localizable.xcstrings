    "A QR code can't hold this much. Shorten the content to create one." : {
      "comment" : "QR-Code Generator: explanation shown instead of the QR code when the content doesn't fit into one",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "So viel passt nicht in einen QR-Code. Kürze den Inhalt, um einen zu erstellen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un código QR no puede contener tanto. Acorta el contenido para crear uno."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un QR code ne peut pas contenir autant. Raccourcissez le contenu pour en créer un."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zoveel past niet in een QR-code. Maak de inhoud korter om er een te maken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kod QR nie pomieści tylu danych. Skróć treść, aby go utworzyć."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um QR code não comporta tanto conteúdo. Encurte o conteúdo para criar um."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Så mycket får inte plats i en QR-kod. Korta ner innehållet för att skapa en."
          }
        }
      }
    },
