    "2. Your installed font should appear in the list" : {
      "comment" : "A step in the font installation process, describing what should happen after installing a font.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "2. Dein installierter Font sollte in der Liste erscheinen"
