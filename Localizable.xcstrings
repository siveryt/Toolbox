            "state" : "translated",
            "value" : "För att visa dina koordinater och din hastighet och för att mäta avstånd."
          }
        }
      }
    },
    "Touch and hold a tool on the main screen to hide it." : {
      "comment" : "Hidden Tools empty state",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
