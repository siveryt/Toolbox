    "Roll a die right on your Home Screen. Tap it to roll again." : {
      "comment" : "Dice widget: description in the widget gallery",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Würfle direkt auf deinem Home-Bildschirm. Tippe auf den Würfel, um erneut zu würfeln."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tira un dado directamente en tu pantalla de inicio. Tócalo para volver a tirar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lancez un dé directement depuis votre écran d’accueil. Touchez-le pour le relancer."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gooi een dobbelsteen direct op je beginscherm. Tik erop om opnieuw te gooien."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rzucaj kością prosto na ekranie początkowym. Stuknij ją, aby rzucić ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Role um dado direto na sua Tela de Início. Toque nele para rolar de novo."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kasta en tärning direkt på hemskärmen. Tryck på den för att kasta igen."
          }
        }
      }
    },
    "Tap %@ to scan again. If nothing shows up, check that Toolbox can access your local network in Settings." : {
      "comment" : "LAN Scanner empty state, %@ is the reload symbol",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippe auf %@, um erneut zu suchen. Wenn nichts erscheint, prüfe in den Einstellungen, ob Toolbox auf dein lokales Netzwerk zugreifen darf."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca %@ para volver a buscar. Si no aparece nada, comprueba en Ajustes que Toolbox pueda acceder a tu red local."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchez %@ pour relancer la recherche. Si rien n’apparaît, vérifiez dans Réglages que Toolbox peut accéder à votre réseau local."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tik op %@ om opnieuw te scannen. Verschijnt er niets, controleer dan in Instellingen of Toolbox toegang heeft tot je lokale netwerk."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stuknij %@, aby skanować ponownie. Jeśli nic się nie pojawi, sprawdź w Ustawieniach, czy Toolbox ma dostęp do sieci lokalnej."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toque em %@ para buscar novamente. Se nada aparecer, verifique nos Ajustes se o Toolbox pode acessar sua rede local."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tryck på %@ för att söka igen. Om inget visas kontrollerar du att Toolbox har åtkomst till ditt lokala nätverk i Inställningar."
          }
        }
      }
    },
    "Tap %@ to scan your first barcode." : {
      "comment" : "Barcode Scanner empty state, %@ is the scan symbol",
      "localizations" : {
        "de" : {
