    "The back display is only available while the camera is active. Allow camera access to show the scrolling text there." : {
      "comment" : "Scrolling Text: alert message",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Rückseite ist nur verfügbar, während die Kamera aktiv ist. Erlaube den Kamerazugriff, um die Laufschrift dort anzuzeigen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La pantalla trasera solo está disponible mientras la cámara está activa. Permite el acceso a la cámara para mostrar ahí el texto en movimiento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’écran arrière n’est disponible que lorsque l’appareil photo est actif. Autorisez l’accès à l’appareil photo pour y afficher le texte défilant."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het achterscherm is alleen beschikbaar als de camera actief is. Geef toegang tot de camera om de lichtkrant daar te tonen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tylny ekran jest dostępny tylko przy aktywnym aparacie. Zezwól na dostęp do aparatu, aby wyświetlać tam przewijany tekst."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A tela traseira só fica disponível enquanto a câmera está ativa. Permita o acesso à câmera para mostrar o texto rolante nela."
          }
        },
