    "Tap %@ to scan again. If nothing shows up, check that Toolbox can access your local network in Settings." : {
      "comment" : "LAN Scanner empty state, %@ is the reload symbol",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippe auf %@, um erneut zu suchen. Wenn nichts erscheint, prüfe in den Einstellungen, ob Toolbox auf dein lokales Netzwerk zugreifen darf."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca %@ para volver a buscar. Si no aparece nada, comprueba en Ajustes que Toolbox pueda acceder a tu red local."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchez %@ pour relancer la recherche. Si rien n’apparaît, vérifiez dans Réglages que Toolbox peut accéder à votre réseau local."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tik op %@ om opnieuw te scannen. Verschijnt er niets, controleer dan in Instellingen of Toolbox toegang heeft tot je lokale netwerk."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stuknij %@, aby skanować ponownie. Jeśli nic się nie pojawi, sprawdź w Ustawieniach, czy Toolbox ma dostęp do sieci lokalnej."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toque em %@ para buscar novamente. Se nada aparecer, verifique nos Ajustes se o Toolbox pode acessar sua rede local."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tryck på %@ för att söka igen. Om inget visas kontrollerar du att Toolbox har åtkomst till ditt lokala nätverk i Inställningar."
          }
        }
      }
    },
    "Tap %@ to scan your first barcode." : {
      "comment" : "Barcode Scanner empty state, %@ is the scan symbol",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippe auf %@, um deinen ersten Barcode zu scannen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca %@ para escanear tu primer código de barras."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchez %@ pour scanner votre premier code-barres."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tik op %@ om je eerste streepjescode te scannen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stuknij %@, aby zeskanować pierwszy kod kreskowy."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toque em %@ para escanear seu primeiro código de barras."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tryck på %@ för att skanna din första streckkod."
          }
        }
      }
    },
    "Tap + to add a device you want to wake up." : {
      "comment" : "Wake On Lan empty state",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippe auf +, um ein Gerät hinzuzufügen, das du aufwecken möchtest."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca + para añadir un dispositivo que quieras activar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchez + pour ajouter un appareil que vous souhaitez réveiller."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tik op + om een apparaat toe te voegen dat je wilt wekken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stuknij +, aby dodać urządzenie, które chcesz wybudzać."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toque em + para adicionar um dispositivo que você deseja ligar."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tryck på + för att lägga till en enhet du vill väcka."
          }
        }
      }
    },
    "Tilt your iPhone to see the light play on the glass." : {
      "comment" : "App icon picker hint",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neige dein iPhone, um das Licht auf dem Glas spielen zu sehen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inclina el iPhone para ver cómo juega la luz sobre el cristal."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inclinez votre iPhone pour voir la lumière jouer sur le verre."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kantel je iPhone om het licht op het glas te zien spelen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pochyl iPhone’a, aby zobaczyć grę światła na szkle."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Incline o iPhone para ver a luz refletir no vidro."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Luta din iPhone för att se ljuset spela i glaset."
          }
        }
      }
    },
    "To find devices on your network and to wake them up." : {
      "comment" : "Permission reason",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um Geräte in deinem Netzwerk zu finden und aufzuwecken."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para encontrar dispositivos en tu red y activarlos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour trouver les appareils de votre réseau et les réveiller."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Om apparaten in je netwerk te vinden en ze te wekken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aby znajdować urządzenia w sieci i je wybudzać."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para encontrar dispositivos na sua rede e ligá-los."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "För att hitta enheter i ditt nätverk och väcka dem."
          }
        }
      }
    },
    "To measure the sound level around you." : {
      "comment" : "Permission reason",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um den Geräuschpegel um dich herum zu messen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para medir el nivel de sonido a tu alrededor."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour mesurer le niveau sonore autour de vous."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Om het geluidsniveau om je heen te meten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aby mierzyć poziom dźwięku w otoczeniu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para medir o nível de som ao seu redor."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "För att mäta ljudnivån omkring dig."
          }
        }
      }
    },
    "To scan barcodes and to show scrolling text on the back display." : {
      "comment" : "Permission reason",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um Barcodes zu scannen und Lauftext auf dem Rückdisplay anzuzeigen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para escanear códigos de barras y mostrar texto en movimiento en la pantalla trasera."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour scanner des codes-barres et afficher du texte défilant sur l’écran arrière."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Om streepjescodes te scannen en lichtkranttekst op het achterscherm te tonen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aby skanować kody kreskowe i wyświetlać przewijany tekst na tylnym ekranie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para escanear códigos de barras e mostrar texto rolante na tela traseira."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "För att skanna streckkoder och visa rullande text på den bakre skärmen."
          }
        }
      }
    },
    "To show your coordinates and speed and to measure distances." : {
      "comment" : "Permission reason",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um deine Koordinaten und Geschwindigkeit anzuzeigen und Entfernungen zu messen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para mostrar tus coordenadas y velocidad y medir distancias."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour afficher vos coordonnées et votre vitesse et mesurer des distances."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Om je coördinaten en snelheid te tonen en afstanden te meten."
