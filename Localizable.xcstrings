    "3. Under 'Downloaded Profile', find your font profile" : {
      "comment" : "A step in the installation process, instructing the user to find their downloaded font profile in the Settings app.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
