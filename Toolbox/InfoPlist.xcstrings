    "NSCameraUsageDescription" : {
      "comment" : "Privacy - Camera Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toolbox braucht Zugriff auf deine Kamera, um Barcodes zu lesen und Laufschrift auf der Rückseite anzuzeigen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Toolbox needs access to the camera to read barcodes and to show scrolling text on the back display."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toolbox necesita acceder a la cámara para leer códigos de barras y mostrar texto en movimiento en la pantalla trasera."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toolbox a besoin d’accéder à l’appareil photo pour lire les codes-barres et afficher du texte défilant sur l’écran arrière."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toolbox heeft toegang tot de camera nodig om streepjescodes te lezen en lichtkranttekst op het achterscherm te tonen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toolbox potrzebuje dostępu do aparatu, aby odczytywać kody kreskowe i wyświetlać przewijany tekst na tylnym ekranie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Toolbox precisa acessar a câmera para ler códigos de barras e mostrar texto rolante na tela traseira."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toolbox behöver åtkomst till kameran för att läsa streckkoder och visa rullande text på den bakre skärmen."
          }
        }
      }
    },
    "NSLocalNetworkUsageDescription" : {
      "comment" : "Privacy - Local Network Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toolbox benötigt Zugriff auf dein lokales Netzwerk für den LAN Scanner, Ping und Wake On Lan"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Toolbox needs access to your local network for the LAN Scanner, Ping and Wake On Lan"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toolbox necesita acceder a tu red local para el escáner de LAN, Ping y Wake On Lan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toolbox a besoin d’accéder à votre réseau local pour le scanner LAN, Ping et Wake On Lan."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toolbox heeft toegang tot je lokale netwerk nodig voor de LAN-scanner, Ping en Wake On Lan"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toolbox potrzebuje dostępu do sieci lokalnej dla LAN Scannera, Pingu i Wake On Lan"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Toolbox precisa acessar sua rede local para o Scanner de LAN, o Ping e o Wake On Lan"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toolbox behöver åtkomst till ditt lokala nätverk för LAN-skannern, Ping och Wake On Lan"
          }
        }
      }
    },
    "NSLocationAlwaysAndWhenInUseUsageDescription" : {
      "comment" : "Privacy - Location Always and When In Use Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toolbox benutzt deinen Standort um deine GPS Koordinaten und deine Geschwindigkeit zu berechnen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Toolbox uses your location to calculate your GPS coordinates and speed"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toolbox usa tu ubicación para calcular tus coordenadas GPS y tu velocidad."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toolbox utilise votre position pour calculer vos coordonnées GPS et votre vitesse."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toolbox gebruikt je locatie om je GPS-coördinaten en snelheid te berekenen"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toolbox używa lokalizacji do obliczania współrzędnych GPS i prędkości"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Toolbox usa sua localização para calcular suas coordenadas GPS e sua velocidade"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toolbox använder din plats för att beräkna dina GPS-koordinater och din hastighet"
          }
        }
      }
    },
