    "NSCameraUsageDescription" : {
      "comment" : "Privacy - Camera Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toolbox braucht Zugriff auf deine Kamera, um Barcodes zu lesen und Laufschrift auf der Rückseite anzuzeigen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Toolbox needs access to the camera to read barcodes and to show scrolling text on the back display."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toolbox necesita acceder a la cámara para leer códigos de barras y mostrar texto en movimiento en la pantalla trasera."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toolbox a besoin d’accéder à l’appareil photo pour lire les codes-barres et afficher du texte défilant sur l’écran arrière."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toolbox heeft toegang tot de camera nodig om streepjescodes te lezen en lichtkranttekst op het achterscherm te tonen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toolbox potrzebuje dostępu do aparatu, aby odczytywać kody kreskowe i wyświetlać przewijany tekst na tylnym ekranie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Toolbox precisa acessar a câmera para ler códigos de barras e mostrar texto rolante na tela traseira."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toolbox behöver åtkomst till kameran för att läsa streckkoder och visa rullande text på den bakre skärmen."
          }
        }
      }
    },
    "NSDocumentsFolderUsageDescription" : {
      "comment" : "Privacy - Documents Folder Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toolbox braucht Zugriff auf deine Dateien, um eine Font zu installieren"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Toolbox needs to access your files to let you select a font file to install"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toolbox necesita acceder a tus archivos para que puedas seleccionar un archivo de tipo de letra e instalarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toolbox a besoin d’accéder à vos fichiers pour vous permettre de choisir un fichier de police à installer."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toolbox heeft toegang tot je bestanden nodig zodat je een lettertypebestand kunt kiezen om te installeren"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toolbox potrzebuje dostępu do plików, aby umożliwić wybór pliku czcionki do zainstalowania"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Toolbox precisa acessar seus arquivos para que você selecione um arquivo de fonte para instalar"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toolbox behöver åtkomst till dina filer så att du kan välja en typsnittsfil att installera"
          }
        }
      }
    },
    "NSLocalNetworkUsageDescription" : {
      "comment" : "Privacy - Local Network Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toolbox benötigt Zugriff auf dein lokales Netzwerk, um den LAN Scanner zu nutzen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Toolbox needs access to your local network to use the LAN Scanner"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toolbox necesita acceder a tu red local para usar el escáner de LAN."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toolbox a besoin d’accéder à votre réseau local pour utiliser le scanner LAN."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toolbox heeft toegang tot je lokale netwerk nodig om de LAN-scanner te gebruiken"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toolbox potrzebuje dostępu do sieci lokalnej, aby korzystać z LAN Scannera"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Toolbox precisa acessar sua rede local para usar o Scanner de LAN"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toolbox behöver åtkomst till ditt lokala nätverk för att använda LAN-skannern"
          }
        }
      }
    },
    "NSLocationAlwaysAndWhenInUseUsageDescription" : {
      "comment" : "Privacy - Location Always and When In Use Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toolbox benutzt deinen Standort um deine GPS Koordinaten und deine Geschwindigkeit zu berechnen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Toolbox uses you location to calculate your GPS coordinates and speed"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toolbox usa tu ubicación para calcular tus coordenadas GPS y tu velocidad."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toolbox utilise votre position pour calculer vos coordonnées GPS et votre vitesse."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toolbox gebruikt je locatie om je GPS-coördinaten en snelheid te berekenen"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toolbox używa lokalizacji do obliczania współrzędnych GPS i prędkości"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Toolbox usa sua localização para calcular suas coordenadas GPS e sua velocidade"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toolbox använder din plats för att beräkna dina GPS-koordinater och din hastighet"
          }
        }
      }
    },
