# App Store screenshot pipeline: capture (snapshot) -> bezels, titles, backgrounds (frameit) -> hooks.
# Run with `bundle exec fastlane <lane>`; see fastlane/hooks/README.md for adding scripts.

default_platform(:ios)

ROOT = File.expand_path("..", __dir__)
SCREENSHOTS = File.join(ROOT, "fastlane", "screenshots")             # iPhone + iPad, framed by frameit
WATCH_SCREENSHOTS = File.join(ROOT, "fastlane", "screenshots-watch") # raw only, frameit has no watch frames
DUO_SCREENSHOTS = File.join(ROOT, "fastlane", "screenshots-duo")     # outer display, laid out by a hook (no frameit bezel)
CREATIVE_ASSETS = File.join(ROOT, "fastlane", "creative-assets")     # header and search results images, built by a hook
PPO = File.join(ROOT, "fastlane", "ppo")                             # product page optimization test variants (variants.json)
HOOKS = File.join(ROOT, "fastlane", "hooks")
WATCH_DEVICES = ["Apple Watch Series 12 (46mm)"]
# The simulator can't unfold the iPhone Duo, so only its outer display can be captured.
DUO_DEVICES = ["iPhone Duo"]

# Font referenced by Framefile.json. frameit only accepts paths relative to the
# Framefile, so the system font is copied in unless you put your own file there.
# Arial Rounded has no Polish letters (ą, ł, ś, …), so Polish uses SF Pro Rounded
# (Framefile.json picks it for the "pl" folder). Get it from
# https://developer.apple.com/fonts/ if /Library/Fonts doesn't have it.
FONTS = {
  "headline.ttf" => "/System/Library/Fonts/Supplemental/Arial Rounded Bold.ttf",
  "headline-extended.otf" => "/Library/Fonts/SF-Pro-Rounded-Bold.otf"
}
UPLOAD = File.join(ROOT, "fastlane", "upload") # staging folder for upload_screenshots

# Copies the Framefile fonts next to it (frameit and the layout hooks use them).
def install_fonts
  FONTS.each do |name, source|
    target = File.join(SCREENSHOTS, "fonts", name)
    next if File.exist?(target)
    UI.user_error!("Font #{source} is missing, see FONTS in the Fastfile") unless File.exist?(source)
    FileUtils.mkdir_p(File.dirname(target))
    FileUtils.cp(source, target)
  end
end

# Runs every executable in fastlane/hooks/<stage>.d in name order.
def run_hooks(stage, screenshots_dir, extra_env = {})
  Dir.glob(File.join(HOOKS, "#{stage}.d", "*")).sort.each do |hook|
    next unless File.file?(hook) && File.executable?(hook)
    UI.message("Hook #{stage}: #{File.basename(hook)}")
    env = { "SCREENSHOTS_DIR" => screenshots_dir, "PROJECT_ROOT" => ROOT, "HOOK_STAGE" => stage }.merge(extra_env)
    UI.user_error!("Hook #{hook} failed") unless system(env, hook, chdir: ROOT)
  end
end

platform :ios do
  desc "Everything for a release: all screenshots and images, then upload texts, screenshots, iPhone Duo screenshots and the header and search results images (needs ASC_KEY_ID, ASC_ISSUER_ID, ASC_KEY_PATH)"
  lane :app_store do
    screenshots
    upload_metadata
    upload_screenshots
    upload_asset_library
  end

  desc "Everything: capture iPhone, iPad, Watch and iPhone Duo, then frame (also builds the header and search results images)"
  lane :screenshots do
    capture
    capture_watch
    capture_duo
    frame
  end

  desc "Capture iPhone and iPad screenshots (devices and languages: Snapfile)"
  lane :capture do
    snapshot
    run_hooks("post_capture", SCREENSHOTS)
  end

  desc "Capture Apple Watch screenshots (raw, no bezel)"
  lane :capture_watch do
    snapshot(
      scheme: "ToolboxWatchUITests",
      devices: WATCH_DEVICES,
      output_directory: WATCH_SCREENSHOTS,
      override_status_bar: false
    )
    run_hooks("post_capture_watch", WATCH_SCREENSHOTS)
  end

  desc "Capture iPhone Duo screenshots (outer display) and lay them out like the framed ones"
  lane :capture_duo do
    snapshot(devices: DUO_DEVICES, output_directory: DUO_SCREENSHOTS)
    install_fonts
    run_hooks("post_capture_duo", DUO_SCREENSHOTS)
  end

  desc "Add bezels, titles and backgrounds to the iPhone and iPad screenshots (layout: screenshots/Framefile.json)"
  lane :frame do
    install_fonts
    frameit(path: SCREENSHOTS)
    run_hooks("post_frame", SCREENSHOTS)
  end

  desc "Frame the screenshots again with the background and colors of every product page optimization variant in fastlane/ppo (run `screenshots` first)"
  lane :ppo_screenshots do
    install_fonts
    config = JSON.parse(File.read(File.join(PPO, "variants.json")))
    config["variants"].each do |variant, settings|
      UI.header("Variant #{variant}")
      out = File.join(PPO, variant, "screenshots")
      duo_out = File.join(PPO, variant, "screenshots-duo")
      FileUtils.rm_rf([out, duo_out])

      # The raw iPhone and iPad screenshots, captions and fonts, framed with this variant's look
      Dir.glob(File.join(SCREENSHOTS, "*")).select { |dir| File.directory?(dir) }.each do |dir|
        target = File.join(out, File.basename(dir))
        FileUtils.mkdir_p(target)
        Dir.glob(File.join(dir, "*")).reject { |file| file.end_with?("_framed.png") }.each { |file| FileUtils.cp(file, target) }
      end
      FileUtils.cp(File.join(PPO, variant, "background.jpg"), File.join(out, "background.jpg"))
      framefile = JSON.parse(File.read(File.join(SCREENSHOTS, "Framefile.json")))
      framefile["default"]["keyword"]["color"] = settings["keyword_color"]
      framefile["default"]["title"]["color"] = settings["title_color"]
      File.write(File.join(out, "Framefile.json"), JSON.pretty_generate(framefile))
      frameit(path: out)

      # The iPhone Duo screenshots, laid out with the same Framefile
      Dir.glob(File.join(DUO_SCREENSHOTS, "*")).select { |dir| File.directory?(dir) }.each do |dir|
        target = File.join(duo_out, File.basename(dir))
        FileUtils.mkdir_p(target)
        Dir.glob(File.join(dir, "*.png")).reject { |file| file.end_with?("_framed.png") }.each { |file| FileUtils.cp(file, target) }
      end
      run_hooks("post_capture_duo", duo_out, "FRAMEFILE" => File.join(out, "Framefile.json"))
    end
  end

  desc "Set up the product page optimization test from fastlane/ppo/variants.json with the ppo_screenshots images; doesn't submit or start it (needs ASC_KEY_ID, ASC_ISSUER_ID, ASC_KEY_PATH; dry_run:true only prints the plan)"
  lane :ppo_create_test do |options|
    require_relative "ppo_experiment"
    token = Spaceship::ConnectAPI::Token.create(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      filepath: ENV.fetch("ASC_KEY_PATH")
    )
    log = ->(message) { UI.message(message) }
    library = AssetLibrary.new(token: token, bundle_id: "de.sivery.toolbox", dry_run: options[:dry_run], log: log)
    PPOExperiment.new(
      library: library,
      config: JSON.parse(File.read(File.join(PPO, "variants.json"))),
      variants_dir: PPO,
      log: log
    ).create(dry_run: options[:dry_run])
  end

  desc "Upload the App Store texts in fastlane/metadata to App Store Connect (needs ASC_KEY_ID, ASC_ISSUER_ID, ASC_KEY_PATH)"
  lane :upload_metadata do
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_filepath: ENV.fetch("ASC_KEY_PATH")
    )
    # Updates the editable app version: name, subtitle, description, keywords and
    # What's New of every language folder, adding languages that don't exist yet.
    # A missing file (e.g. name.txt for en-US) leaves that field as it is.
    upload_to_app_store(
      api_key: api_key,
      app_identifier: "de.sivery.toolbox",
      metadata_path: File.join(ROOT, "fastlane", "metadata"),
      skip_binary_upload: true,
      skip_screenshots: true,
      skip_app_version_update: true,
      run_precheck_before_submit: false,
      force: true
    )
  end

  desc "Upload the product page header and search results images through the App Asset Library API, which deliver doesn't support (needs ASC_KEY_ID, ASC_ISSUER_ID, ASC_KEY_PATH; dry_run:true only prints the plan)"
  lane :upload_asset_library do |options|
    require_relative "asset_library"
    token = Spaceship::ConnectAPI::Token.create(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      filepath: ENV.fetch("ASC_KEY_PATH")
    )
    jobs = []
    Dir.glob(File.join(CREATIVE_ASSETS, "*")).select { |dir| File.directory?(dir) }.sort.each do |dir|
      locale = File.basename(dir)
      jobs << { locale: locale, placement_type: "PRODUCT_PAGE_HEADER_ASSET", display_class: nil, files: [File.join(dir, "header.png")] }
      jobs << { locale: locale, placement_type: "APP_STORE_SEARCH_RESULTS_ASSET", display_class: nil, files: [File.join(dir, "search.png")] }
    end
    UI.user_error!("Nothing to upload, run `fastlane screenshots` first") if jobs.empty?
    AssetLibrary.new(token: token, bundle_id: "de.sivery.toolbox", dry_run: options[:dry_run],
                     log: ->(message) { UI.message(message) }).upload(jobs)
  end

  desc "Upload the framed iPhone, iPad and iPhone Duo and the Watch screenshots to App Store Connect (needs ASC_KEY_ID, ASC_ISSUER_ID, ASC_KEY_PATH)"
  lane :upload_screenshots do
    FileUtils.rm_rf(UPLOAD)
    # deliver sorts them into display types by pixel size (the iPhone Duo since fastlane 2.241)
    [[SCREENSHOTS, "*_framed.png"], [WATCH_SCREENSHOTS, "*.png"], [DUO_SCREENSHOTS, "*_framed.png"]].each do |dir, pattern|
      Dir.glob(File.join(dir, "*", pattern)).each do |file|
        language = File.join(UPLOAD, File.basename(File.dirname(file)))
        FileUtils.mkdir_p(language)
        FileUtils.cp(file, language)
      end
    end
    UI.user_error!("Nothing to upload, run `fastlane screenshots` first") unless Dir.exist?(UPLOAD)
    run_hooks("pre_upload", UPLOAD)

    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_filepath: ENV.fetch("ASC_KEY_PATH")
    )
    # Replaces the screenshots of the editable app version; touches nothing else.
    upload_to_app_store(
      api_key: api_key,
      app_identifier: "de.sivery.toolbox",
      screenshots_path: UPLOAD,
      overwrite_screenshots: true,
      skip_binary_upload: true,
      skip_metadata: true,
      skip_app_version_update: true,
      run_precheck_before_submit: false,
      force: true
    )
  end
end
